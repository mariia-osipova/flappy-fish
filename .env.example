PORT=3000
HOST=0.0.0.0
APP_ENV=production

# Leave false until staging, migration, and retirement of ALL old public writers.
RANKED_ENABLED=false

# Select exactly one durable backend. Omit all backend settings for practice-only.
STORAGE_BACKEND=postgres

# Northflank PostgreSQL addon connection string. Keep private and server-only.
DATABASE_URL=
DB_POOL_MAX=4
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
MAX_RANKED_GAMES=5

# Transitional Apps Script backend only. Remove these from PostgreSQL runtime.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# SESSION and STATE must differ and be at least 32 bytes. Apps Script additionally
# requires a third distinct GATEWAY key. Never ship any of them to the browser.
# Generate each separately with: openssl rand -hex 32
# Only GATEWAY_HMAC_KEY is also set in Apps Script Script Properties.
SESSION_HMAC_KEY=
STATE_HMAC_KEY=
GATEWAY_HMAC_KEY=

# Bounded Node replay workers. Deadline is fixed at 250ms per block.
VERIFIER_WORKERS=2
VERIFIER_QUEUE=10
GATEWAY_TIMEOUT_MS=10000

# MAX_RANKED_GAMES=5 is an Apps Script Script Property, not a client setting.
